# Local API configuration
PORT=4444
DATABASE_PATH=./data/smsense.sqlite3
FAISS_INDEX_PATH=./data/scam_examples.index
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
# Primary Indian SMS classifier; install once with the Ollama command in README.md.
SMSENSE_CLASSIFIER_MODEL=hf.co/ganmoor-ai-labs/sms-shield:Q4_K_M
# Optional multilingual challenger; diagnostic-only and not part of production scoring.
INDICBERT_ENABLED=false
INDICBERT_MODEL=anmolshrivastav/indicbert-scam-classifier-v2
MODEL_LOAD_ON_STARTUP=false
# Optional: Google Safe Browsing API key. Blank disables external URL lookups.
# When enabled, only extracted URL strings are sent to Google, never the full SMS.
GOOGLE_SAFE_BROWSING_API_KEY=
# Comma-separated exact browser origins allowed by CORS for local development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
ANALYSIS_HISTORY_LIMIT=100
RISK_LOW_THRESHOLD=25
RISK_SUSPICIOUS_THRESHOLD=50
RISK_HIGH_RISK_THRESHOLD=75
# Optional enrichments are bounded so they cannot indefinitely delay the core SMS result.
SMSENSE_SIMILARITY_TIMEOUT_SECONDS=3.0
SMSENSE_URL_REPUTATION_TIMEOUT_SECONDS=4.0
SMSENSE_CLASSIFIER_TIMEOUT_SECONDS=600.0
SMSENSE_CHALLENGER_TIMEOUT_SECONDS=2.0
